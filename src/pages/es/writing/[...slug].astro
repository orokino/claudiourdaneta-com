---
import Layout from '../../../layouts/Layout.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import { render } from 'astro:content';
import { ui } from '../../../i18n/strings';
import {
  getPostsForLocale,
  findTranslation,
  getSlugFromId,
  altLocaleHomeUrl,
} from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getPostsForLocale('es');
  return posts.map((post) => ({
    params: { slug: getSlugFromId(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const translation = await findTranslation(post, 'en');
const alternateUrl = translation
  ? `/writing/${getSlugFromId(translation.id)}/`
  : altLocaleHomeUrl('es');

const formatted = post.data.date.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = post.data.date.toISOString();
---
<Layout
  title={`${post.data.title} — Claudio Urdaneta`}
  description={post.data.description}
  lang="es"
  alternateUrl={alternateUrl}
>
  <main>
    <header class="masthead">
      <a href="/es/" class="back-link">{ui.es.backLink}</a>
      <LanguageSwitcher currentLocale="es" alternateUrl={alternateUrl} />
    </header>

    <article>
      <header class="post-header">
        <time class="post-date" datetime={isoDate}>{formatted}</time>
        <h1 class="post-title">{post.data.title}</h1>
      </header>

      <div class="post-content">
        <Content />
      </div>
    </article>

    <footer class="post-footer">v1.0 · last updated 2026-05-03</footer>
  </main>
</Layout>
