---
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { ui, projectDescriptions } from '../../i18n/strings';
import { getPostsForLocale, getSlugFromId } from '../../i18n/utils';

const t = ui.es;
const posts = await getPostsForLocale('es');

const projects = [
  { key: 'salvux', desc: projectDescriptions.es.salvux },
  { key: 'alaric', desc: projectDescriptions.es.alaric },
];

const links = [
  { label: 'github',   href: 'https://github.com/orokino' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/claudio-urdaneta-397a31285/' },
  { label: 'email',    href: 'mailto:caua1809@gmail.com' },
];
---
<Layout lang="es" alternateUrl="/">
  <main>
    <header class="masthead">
      <span class="name">Claudio Urdaneta</span>
      <LanguageSwitcher currentLocale="es" alternateUrl="/" />
    </header>

    <p class="bio">{t.bio}</p>

    <section>
      <h2 class="section-header">{t.sections.writing}</h2>
      {posts.map((post) => (
        <div class="entry">
          <span class="entry-key">{post.data.date.getFullYear()}</span>
          <span class="entry-desc"><a href={`/es/writing/${getSlugFromId(post.id)}/`}>{post.data.title}</a></span>
        </div>
      ))}
    </section>

    <section>
      <h2 class="section-header">{t.sections.projects}</h2>
      {projects.map((p) => (
        <div class="entry">
          <span class="entry-key">{p.key}</span>
          <span class="entry-desc">{p.desc}</span>
        </div>
      ))}
    </section>

    <section>
      <h2 class="section-header">{t.sections.elsewhere}</h2>
      <p class="elsewhere">
        {links.map((l, i) => (
          <>
            <a href={l.href}>{l.label}</a>{i < links.length - 1 && <span class="dot">·</span>}
          </>
        ))}
      </p>
    </section>

    <footer>v1.0 · last updated 2026-05-03</footer>
  </main>
</Layout>
