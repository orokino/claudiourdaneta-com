---
import '../styles/global.css';
import type { Locale } from '../i18n/strings';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  alternateUrl?: string;
}

const {
  title = 'Claudio Urdaneta',
  description = 'Medical student at Universidad de La Laguna, working toward a career in clinical AI radiology.',
  lang = 'en',
  alternateUrl,
} = Astro.props;

const altLang: Locale = lang === 'en' ? 'es' : 'en';
const siteOrigin = 'https://claudiourdaneta.com';
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@300,400,500&display=swap" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternateUrl && (
      <link rel="alternate" hreflang={altLang} href={`${siteOrigin}${alternateUrl}`} />
    )}
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteOrigin}${Astro.url.pathname}`} />
    <meta property="og:locale" content={ogLocale} />
  </head>
  <body>
    <slot />
  </body>
</html>
