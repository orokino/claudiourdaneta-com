---
import type { Locale } from '../i18n/strings';

interface Props {
  currentLocale: Locale;
  alternateUrl: string;
}

const { currentLocale, alternateUrl } = Astro.props;
const enHref = currentLocale === 'en' ? '#' : alternateUrl;
const esHref = currentLocale === 'es' ? '#' : alternateUrl;
---
<nav class="lang-switcher" aria-label="Language">
  <a
    href={enHref}
    class:list={['lang-link', { active: currentLocale === 'en' }]}
    aria-current={currentLocale === 'en' ? 'page' : undefined}
  >EN</a>
  <span class="lang-sep">·</span>
  <a
    href={esHref}
    class:list={['lang-link', { active: currentLocale === 'es' }]}
    aria-current={currentLocale === 'es' ? 'page' : undefined}
  >ES</a>
</nav>
